# 개인 자료 — 공유·커밋·패키지 금지(계약 §1.2: 번들·개인 자료는 data\, 개인 보고서는 out\)
# 루트 고정('/') — 'data/' 로 쓰면 lm27\hier\data\ 같은 하위 data 폴더까지 무시돼 소스 파일이 커밋에서 빠진다
/data/
/out/

# 개인 설정 덮어쓰기(배포 기본값은 config\settings_registry.json 의 default) — 사람마다 다름
config/config.json
# Agentic 로컬 카탈로그(LM24 형식 — 사내 과제 기획 내용, 폴더와 함께 옮김 · 계약 v1.3 §0.8 V13)
config/agentic_tasks.json

# 파이썬 캐시
__pycache__/
*.pyc

# 원자 쓰기 조각(계약 §1.5) — 남으면 실패 흔적이다
*.part

# 작업 산출물(패키지 zip 은 tools\make_package.py 가 트리 밖에 만든다)
*.zip
# 동봉 파이썬의 표준 라이브러리 — 빠지면 python\python.exe 가 아무것도 못 한다
!python/python311.zip

# 오케스트레이터 작업 스크립트(개발용)
.wf/
